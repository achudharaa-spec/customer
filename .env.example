# =============================================================================
# Firebase Web Configuration Template for Customer Wholesale Portal (Vite)
# Govindasamy & Co / Surya Tex - Customer Ordering Platform
# =============================================================================
# Copy this file to .env in this directory (surya-tex-user/.env)
# Fill in your new Firebase project credentials from:
# Firebase Console -> Project Settings -> General -> Your apps -> Web app
# =============================================================================

# 1. Firebase Web App Configuration Keys
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# 2. Store Contact Details (Printed on Proforma Invoices & Order Confirmations)
VITE_WHATSAPP_NUMBER=919842932756
VITE_STORE_EMAIL=your_store_email@example.com

# 3. Optional: reCAPTCHA v3 site key for Firebase App Check
VITE_RECAPTCHA_SITE_KEY=

# 4. Optional: Firebase Local Emulator Suite (set true only during local offline testing)
VITE_USE_FIREBASE_EMULATOR=false
